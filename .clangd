CompileFlags:
  Compiler: C:/Users/brite/.platformio/packages/toolchain-riscv32-esp/bin/riscv32-esp-elf-gcc.exe
  Remove:
    - -march=*
    - -mabi=*
    - -mtune=*
    - -mlongcalls
    - -mtext-section-literals
    - -fno-shrink-wrap
    - -fno-tree-switch-conversion
    - -fstrict-volatile-bitfields
    - -fno-jump-tables
    - -fno-malloc-dce
    - -fzero-init-padding-bits=*
    - -mdisable-hardware-atomics
    - -flto*
    - -fno-fat-lto-objects
Diagnostics:
  UnusedIncludes: None
